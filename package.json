{
  "name": "agentic-chat-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "node scripts/clean.mjs && pnpm -r build && node scripts/copy-package-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "verify:node": "pnpm --filter @agentic-chat/node-harness test",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify": "pnpm check:boundaries && pnpm typecheck && pnpm test && pnpm build && pnpm verify:node && pnpm verify:packages"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
