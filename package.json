{
  "name": "agentic-chat-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "build": "node scripts/clean.mjs && pnpm -r build && node scripts/copy-package-assets.mjs",
    "clean": "node scripts/clean.mjs",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:css-scope": "node scripts/check-css-scope.mjs",
    "check:release": "node scripts/check-release-config.mjs",
    "check:size": "node scripts/check-package-size.mjs",
    "check:security": "node scripts/check-security.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "api:check": "node scripts/check-public-api.mjs",
    "api:update": "node scripts/check-public-api.mjs --update",
    "api:governance": "node scripts/check-api-governance.mjs",
    "storybook": "pnpm --filter @agentic-chat/storybook dev",
    "storybook:build": "pnpm --filter @agentic-chat/storybook... build",
    "quality:build": "pnpm --filter @agentic-chat/storybook... --filter @agentic-chat/fixture-player... build",
    "quality:browser": "pnpm quality:build && playwright test --config playwright.quality.config.ts",
    "quality:browser:update": "pnpm quality:build && playwright test --config playwright.quality.config.ts --update-snapshots",
    "quality:a11y": "pnpm quality:build && playwright test --config playwright.quality.config.ts --grep accessibility",
    "quality:keyboard": "pnpm quality:build && playwright test --config playwright.quality.config.ts --grep \"keyboard|tab order\"",
    "quality:visual": "pnpm quality:build && playwright test --config playwright.quality.config.ts --grep \"visual baseline|narrow viewport\"",
    "docs:build": "pnpm --filter @agentic-chat/minimal... build && pnpm --filter @agentic-chat/docs... build",
    "docs:check": "node scripts/check-docs.mjs",
    "examples:verify": "pnpm --filter @agentic-chat/examples... build",
    "quality": "pnpm check:css-scope && pnpm build && pnpm check:size && pnpm quality:browser",
    "changeset": "changeset",
    "changeset:pre-enter": "changeset pre enter alpha",
    "changeset:pre-enter-beta": "changeset pre enter beta",
    "changeset:pre-exit": "changeset pre exit",
    "version:packages": "changeset version",
    "release:alpha": "pnpm build && changeset publish",
    "release:beta": "node scripts/publish-beta.mjs",
    "release:beta:check": "node scripts/check-beta-release.mjs --registry",
    "release:check": "node scripts/check-stable-release.mjs",
    "release:publish": "node scripts/publish-stable-release.mjs",
    "verify:node": "pnpm --filter @agentic-chat/node-harness test",
    "verify:host:ai-sdk": "node scripts/verify-registry-ai-sdk-host.mjs",
    "verify:packages": "node scripts/verify-packages.mjs",
    "verify": "pnpm check:boundaries && pnpm check:css-scope && pnpm check:release && pnpm check:security && pnpm check:licenses && pnpm docs:check && pnpm typecheck && pnpm test && pnpm build && pnpm examples:verify && pnpm docs:build && pnpm api:check && pnpm api:governance && pnpm check:size && pnpm verify:node && pnpm verify:packages"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@changesets/cli": "^2.31.1",
    "@microsoft/api-extractor": "^7.58.12",
    "@playwright/test": "1.61.1",
    "@storybook/react-vite": "10.5.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "10.5.3",
    "typescript": "~7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.0"
  }
}
