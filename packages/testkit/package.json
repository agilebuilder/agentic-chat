{
  "name": "@agentic-chat/testkit",
  "version": "0.1.0-beta.1",
  "type": "module",
  "description": "Fixtures and conformance helpers for Agentic Chat UI adapters.",
  "homepage": "https://github.com/agilebuilder/agentic-chat#readme",
  "bugs": { "url": "https://github.com/agilebuilder/agentic-chat/issues" },
  "keywords": ["agent", "chat", "adapter", "testing", "conformance"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agilebuilder/agentic-chat.git",
    "directory": "packages/testkit"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@agentic-chat/core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  }
}
